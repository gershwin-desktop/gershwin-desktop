#!/bin/bash
set -ex

# https://wiki.debian.org/VirtualBox#Debian_10_.22Buster.22.2C_Debian_11_.22Bullseye.22.2C_and_Debian_12_.22Bookworm.22

echo "deb http://deb.debian.org/debian $(lsb_release -cs)-backports main contrib" |
tee /etc/apt/sources.list.d/backports.list
apt-get install -y fasttrack-archive-keyring

# signed-by is required as of trixie. Up to bookworm, fasttrack-archive-keyring
# dropped its key into /etc/apt/trusted.gpg.d, where apt trusted it for every
# repo, so a bare "deb" line worked. Since 2025.02.16 the package ships the key
# to /usr/share/keyrings only -- part of Debian moving away from global trust --
# so without pointing at it here apt fails with "Missing key
# 1FC324F50C00F13AE448A88CC47F8A8AAD743EF7" and the repo is treated as unsigned.
ft_key=/usr/share/keyrings/fasttrack-archive-keyring.gpg
echo "deb [signed-by=${ft_key}] http://fasttrack.debian.net/debian-fasttrack/ $(lsb_release -cs)-fasttrack main contrib" |
tee /etc/apt/sources.list.d/fasttrack.list
echo "deb [signed-by=${ft_key}] http://fasttrack.debian.net/debian-fasttrack/ $(lsb_release -cs)-backports-staging main contrib" |
tee -a /etc/apt/sources.list.d/fasttrack.list
apt-get update
if [[ "$(uname -m)" == "i686" ]] || [[ "$(uname -m)" == "x86_64" ]]; then
    apt-get -y install virtualbox-guest-utils
else
    echo "Skipping virtualbox-guest-utils since not on an i686 or x86_64 system"
fi
